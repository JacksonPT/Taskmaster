// Prisma schema defines the database shape in code.
// After editing this file, Prisma can generate TypeScript types and migrations.

generator client {
  // Prisma 7 generates a local TypeScript client at the output path below.
  // Our app imports that generated client from lib/prisma.ts.
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  // Neon hosts PostgreSQL, and Prisma reads the connection URL from prisma.config.ts.
  provider = "postgresql"
}

// Enums limit a field to a small list of allowed values.
// This keeps database values predictable and mirrors the UI priority badges.
enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

// These statuses map to the current UI states: Todo, In Progress, and Done.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  // cuid() creates unique string ids without needing the database to count upward.
  id String @id @default(cuid())

  title       String
  description String

  // Defaults let us create a task without manually providing every field.
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(TODO)

  // dueDate is optional because users may create tasks without a deadline.
  dueDate DateTime?

  // Completion guidance has one short summary plus an ordered PostgreSQL text array.
  // The empty-list default means tasks can exist before a user requests AI help.
  aiSuggestion String?
  aiSteps      String[] @default([])

  // Structured AI priority output is stored separately from the later
  // completion-suggestion feature so each concept has one database field.
  priorityReason String?

  // Clerk is the identity provider, so its user id becomes our ownership key.
  // This stays nullable only so pre-auth development rows are not destroyed.
  // Application queries never return null-owned rows, and all new tasks set userId.
  userId String?

  // Timestamps are useful for sorting, auditing, and dashboard stats later.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A task can appear in the user's current daily plan with an order and reason.
  dailyPlanItems DailyPlanItem[]

  // PostgreSQL can use this index to locate one user's rows efficiently.
  @@index([userId])
}

// Each Clerk user has at most one current plan. Regeneration replaces its items
// instead of creating plan history, which keeps the first daily-planning version focused.
model DailyPlan {
  id      String @id @default(cuid())
  userId  String @unique
  summary String

  // planDate is a trusted UTC YYYY-MM-DD key created by the server.
  planDate    String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items DailyPlanItem[]
}

// This association model links a plan to a task while storing AI-specific
// metadata that does not belong directly on either parent record.
model DailyPlanItem {
  id          String @id @default(cuid())
  dailyPlanId String
  taskId      String
  position    Int
  reason      String

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // One task and one numeric position may each appear only once per plan.
  @@unique([dailyPlanId, taskId])
  @@unique([dailyPlanId, position])
  @@index([taskId])
}

// Usage survives plan replacement or deletion, preventing those operations from
// resetting the limit of two Gemini daily-plan calls per UTC calendar day.
model DailyPlanUsage {
  id              String   @id @default(cuid())
  userId          String
  usageDate       String
  generationCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, usageDate])
  @@index([userId])
}

// A unique reservation identifies the exact in-flight request holding a quota
// slot. Abandoned rows expire, while one request can never release another's slot.
model DailyPlanReservation {
  id        String   @id @default(cuid())
  userId    String
  usageDate String
  createdAt DateTime @default(now())

  @@index([userId, usageDate])
}
